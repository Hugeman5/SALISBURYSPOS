rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public profile docs used by the login grid.
    // DO NOT store pinHash or other secrets here.
    match /users/{uid} {
      allow get, list: if true;            // allow unauth read for login grid
      allow create, update, delete: if isAdminOrManager();
    }

    // Secrets only. Client must never reach this.
    match /userSecrets/{uid} {
      allow read, write: if false;         // block client entirely
    }

    // PRODUCTS
    match /products/{id} {
      allow read: if true;
      allow create, update: if isAdminOrManager();
      allow delete: if isAdmin(); // delete restricted to admin
    }

    // CATEGORIES
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdminOrManager();
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    function isManager() {
      return request.auth != null && request.auth.token.role == 'manager';
    }

    function isAdminOrManager() {
      return request.auth != null && (request.auth.token.role == 'admin' || request.auth.token.role == 'manager');
    }
  }
}
