rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth.token.role in ['admin', 'manager'];
    }
    match /user_secrets/{userId} {
      allow read: if true;
      allow write: if request.auth.token.role in ['admin', 'manager'];
    }
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.role in ['admin', 'manager'];
    }
    match /categories/{categoryId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.role in ['admin', 'manager'];
    }
    match /orders/{orderId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth.token.role in ['admin', 'manager', 'cashier'];
    }
    match /orders/{orderId}/refunds/{refundId} {
      allow read: if request.auth.token.role in ['admin', 'manager', 'cashier'];
      allow create: if request.auth.token.role in ['admin', 'manager', 'cashier'];
    }
    match /inventory_ledger/{ledgerId} {
      allow read: if request.auth.token.role in ['admin', 'manager'];
      allow create: if request.auth.token.role in ['admin', 'manager'];
    }
    match /register_sessions/{sessionId} {
      allow read: if request.auth.token.role in ['admin', 'manager', 'cashier'];
      allow write: if request.auth.token.role in ['admin', 'manager'];
    }
     match /register_sessions/{sessionId}/cash_movements/{movementId} {
      allow read: if request.auth.token.role in ['admin', 'manager', 'cashier'];
      allow create: if request.auth.token.role in ['admin', 'manager'];
    }
    match /z_closures/{closureId} {
        allow read: if request.auth.token.role in ['admin', 'manager'];
        allow write: if request.auth.token.role in ['admin', 'manager'];
    }
     match /time_clock/{punchId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // New rules for Menu Builder and Floor Plan
    match /menus/{menuId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.role in ['admin', 'manager'];
    }
    match /menu_screens/{screenId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.role in ['admin', 'manager'];
    }
    match /menu_buttons/{buttonId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.role in ['admin', 'manager'];
    }
    match /items/{itemId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.role in ['admin', 'manager'];
    }
    match /modifier_groups/{groupId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.role in ['admin', 'manager'];
    }
    match /combos/{comboId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.role in ['admin', 'manager'];
    }
    match /price_rules/{ruleId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.role in ['admin', 'manager'];
    }
    match /menu_availability/{availabilityId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.role in ['admin', 'manager'];
    }
    match /floor_plans/{planId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.role in ['admin', 'manager'];
    }
    match /table_state/{stateId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.role in ['admin', 'manager', 'cashier', 'waiter'];
    }
  }
}
