
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Login: Allow public read of users for login screen
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role in ['admin', 'manager'];
    }
    
    // User Secrets: Backend/Admin only
    match /user_secrets/{uid} {
      allow read, write: if request.auth != null && request.auth.token.role in ['admin', 'manager'];
    }

    // Menu Data: Staff can read, managers/admins can write
    match /menu_categories/{id} {
      allow read: if request.auth != null && request.auth.token.role in ['admin', 'manager', 'cashier', 'waiter', 'kitchen'];
      allow write: if request.auth != null && request.auth.token.role in ['admin', 'manager'];
    }
    match /menu_items/{id} {
      allow read: if request.auth != null && request.auth.token.role in ['admin', 'manager', 'cashier', 'waiter', 'kitchen'];
      allow write: if request.auth != null && request.auth.token.role in ['admin', 'manager'];
    }
    match /modifier_groups/{id} {
      allow read: if request.auth != null && request.auth.token.role in ['admin', 'manager', 'cashier', 'waiter', 'kitchen'];
      allow write: if request.auth != null && request.auth.token.role in ['admin', 'manager'];
    }

    // Floor Plans & State: Staff can read, managers/admins can write plans, waiters+ can write state
    match /floor_plans/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role in ['admin', 'manager'];
    }
    match /table_state/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role in ['admin', 'manager', 'cashier', 'waiter'];
    }

    // Orders and financial data should be more restrictive
    match /orders/{id} {
      allow read, write: if request.auth != null && request.auth.token.role in ['admin', 'manager', 'cashier', 'waiter'];
    }
    match /register_sessions/{id}/{any=**} {
      allow read, write: if request.auth != null && request.auth.token.role in ['admin', 'manager', 'cashier'];
    }
    match /z_closures/{id} {
      allow read, write: if request.auth != null && request.auth.token.role in ['admin', 'manager'];
    }

    // Default deny all other collections
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
