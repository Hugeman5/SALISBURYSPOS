rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function hasRole(allowedRoles) {
      return request.auth != null && request.auth.token.role in allowedRoles;
    }
    
    function isAdmin() {
      return hasRole(['admin']);
    }

    function isManagerOrAdmin() {
      return hasRole(['admin', 'manager']);
    }

    function isStaff() {
      return request.auth != null && request.auth.token.role in ['cashier', 'waiter', 'manager', 'admin'];
    }
    
    function isAuthed() {
      return request.auth != null;
    }

    // Public profile docs used by the login grid.
    // DO NOT store pinHash or other secrets here.
    match /users/{uid} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isManagerOrAdmin() && !('pinHash' in request.resource.data);
      allow delete: if isAdmin();
    }

    // Secrets only. Client must never reach this.
    match /userSecrets/{uid} {
      allow read, write: if false;         // block client entirely
    }

    // PRODUCTS
    match /products/{id} {
      allow read: if true;
      allow create, update: if isManagerOrAdmin();
      allow delete: if isAdmin();
    }

    // CATEGORIES
    match /categories/{id} {
      allow read: if true;
      allow write: if isManagerOrAdmin();
    }
    
    // Inventory ledger
    match /inventory_ledger/{docId} {
      allow read: if isAuthed();
      // Writes only via privileged roles through Cloud Functions
      allow create: if isManagerOrAdmin();
      allow update, delete: if false; // append-only
    }
    
    // ORDERS & DAY SUMMARIES
    match /orders/{orderId} {
      allow read: if isStaff();
      allow write: if false; // all writes via CF

      match /lines/{lineId} {
        allow read: if isStaff();
        allow write: if false;
      }

      match /payments/{paymentId} {
        allow read: if isStaff();
        allow write: if false;
      }
    }
    
    match /day_summaries/{id} {
      allow read: if isStaff();
      allow write: if false; // CF only
    }
  }
}
