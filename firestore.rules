
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read of users for login screen
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Require auth for all other documents
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
