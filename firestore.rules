rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check for admin/manager roles from the auth token custom claims
    function isManager() {
      return request.auth.token.role in ['admin', 'manager'];
    }
    
    // Helper function to check for staff roles
    function isStaff() {
      return request.auth.token.role in ['admin', 'manager', 'cashier', 'waiter'];
    }

    // Public user profiles - readable by anyone for login screen, writable by owner or manager+
    match /users/{userId} {
      allow read: if true;
      allow write: if isManager() || request.auth.uid == userId;
    }
    
    // User secrets (like PIN hashes) should not be readable by the client
    match /user_secrets/{secretId} {
      allow read, write: if false; // Only accessible via Admin SDK in functions
    }

    // Menu-related collections
    match /menus/{docId} {
      allow read: if request.auth != null;
      allow write: if isManager();
    }
    match /menu_screens/{docId} {
      allow read: if request.auth != null;
      allow write: if isManager();
    }
    match /menu_buttons/{docId} {
      allow read: if request.auth != null;
      allow write: if isManager();
    }
    match /items/{docId} {
      allow read: if request.auth != null;
      allow write: if isManager();
    }
    match /modifier_groups/{docId} {
      allow read: if request.auth != null;
      allow write: if isManager();
    }
     match /combos/{docId} {
      allow read: if request.auth != null;
      allow write: if isManager();
    }
     match /price_rules/{docId} {
      allow read: if request.auth != null;
      allow write: if isManager();
    }
    match /menu_availability/{docId} {
      allow read: if request.auth != null;
      allow write: if isManager();
    }
    match /categories/{docId} {
      allow read: if request.auth != null;
      allow write: if isManager();
    }
    match /products/{docId} {
      allow read: if request.auth != null;
      allow write: if isManager();
    }

    // Floor plan configuration
    match /floor_plans/{docId} {
      allow read: if request.auth != null;
      allow write: if isManager();
    }
    
    // Live table state, writable by more roles
    match /table_state/{docId} {
      allow read: if request.auth != null;
      allow write: if isStaff();
    }

    // All other collections require at least an authenticated user for any access
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
