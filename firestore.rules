rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function hasRole(r) {
      return request.auth.token.role == r;
    }
    function isAdminOrManager() {
      return hasRole('admin') || hasRole('manager');
    }

    // --- Users & Secrets ---
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdminOrManager();
    }
    match /user_secrets/{userId} {
      allow read, write: if false; // Only accessible by backend functions
    }
    
    // --- Products & Inventory ---
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if isAdminOrManager();
    }
    match /categories/{categoryId} {
      allow read: if request.auth != null;
      allow write: if isAdminOrManager();
    }
    match /inventory_ledger/{ledgerId} {
      allow read: if isAdminOrManager();
      allow create: if isAdminOrManager();
      allow update, delete: if false;
    }

    // --- Orders & Sales ---
    match /orders/{oid} {
      allow read: if request.auth != null;
      allow update: if request.auth != null && (hasRole('admin') || hasRole('manager') || hasRole('cashier'));
      allow create: if request.auth != null && (hasRole('admin') || hasRole('manager') || hasRole('cashier'));
    }
    
    match /returns_ledger/{rid} {
      allow read: if request.auth != null;
      allow create: if isAdminOrManager() || hasRole('cashier');
      allow update, delete: if false;
    }

    // --- Time Clock & Sessions ---
    match /time_clock/{tid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null; // any staff can clock-in/out
      allow update: if request.auth != null && (resource.data.userId == request.auth.uid || isAdminOrManager());
      allow delete: if false;
    }

    match /register_sessions/{sid} {
      allow read: if request.auth != null; // visible to signed-in staff
      allow create: if request.auth != null && (hasRole('admin') || hasRole('manager') || hasRole('cashier'));
      allow update: if isAdminOrManager() || (hasRole('cashier') && request.resource.data.status == 'closed');
      allow delete: if false; // immutable bookkeeping
    }
    
    match /z_closures/{zid} {
      allow read: if request.auth != null;
      allow create: if isAdminOrManager();
      allow update, delete: if false; // idempotent; create-only
    }
  }
}
