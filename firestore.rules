rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Login screen needs public access to users with pins
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role IN ['admin', 'manager'];
    }
    match /user_secrets/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role IN ['admin', 'manager'];
    }

    // Menu & Floor data can be read by any authenticated staff
    // but only written by admin/managers
    function isStaff() {
      return request.auth != null && request.auth.token.role IN ['admin', 'manager', 'cashier', 'waiter', 'kitchen'];
    }
    function isManager() {
      return request.auth != null && request.auth.token.role IN ['admin', 'manager'];
    }
    
    match /menu_categories/{id} { allow read: if isStaff(); allow write: if isManager(); }
    match /menu_items/{id} { allow read: if isStaff(); allow write: if isManager(); }
    match /modifier_groups/{id} { allow read: if isStaff(); allow write: if isManager(); }
    match /floor_plans/{id} { allow read: if isStaff(); allow write: if isManager(); }

    // Table state can be updated by more roles
    function canServe() {
      return request.auth != null && request.auth.token.role IN ['admin', 'manager', 'cashier', 'waiter'];
    }
    match /table_state/{id} {
      allow read: if isStaff();
      allow write: if canServe();
    }
    
    // Orders can be managed by serving staff
    match /orders/{id} {
      allow read: if isStaff();
      allow write: if canServe();
    }
  }
}
