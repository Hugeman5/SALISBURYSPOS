rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getRole() {
      return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role;
    }

    function isRole(role) {
      return isSignedIn() && getRole() == role;
    }
    
    function hasAnyRole(roles) {
       return isSignedIn() && getRole() in roles;
    }

    // Admins have god mode
    match /{path=**} {
      allow read, write: if hasAnyRole(['admin']);
    }
    
    // --- Users ---
    // Managers can manage most users, but not other admins/managers.
    // Cashiers and below can only read their own data.
    match /users/{userId} {
      allow read: if hasAnyRole(['admin', 'manager']) || request.auth.uid == userId;
      allow create: if hasAnyRole(['admin', 'manager']);
      allow update: if hasAnyRole(['admin']) || (hasAnyRole(['manager']) && resource.data.role != 'admin' && request.resource.data.role != 'admin');
      // Prevent client from writing pinHash
      allow write: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'role', 'active', 'updatedAt', 'email', 'phone']);
    }

    // --- Products & Categories ---
    // Managers can manage products and categories.
    // Staff can read them.
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if hasAnyRole(['admin', 'manager']);
    }
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if hasAnyRole(['admin', 'manager']);
    }

    // --- Inventory ---
    // Managers can adjust inventory.
    match /inventory_ledger/{entryId} {
        allow read, create: if hasAnyRole(['admin', 'manager']);
        allow update, delete: if false;
    }

    // --- Orders ---
    // Cashiers/Waiters can create orders.
    // Managers can view all orders.
    match /orders/{orderId} {
      allow read: if hasAnyRole(['admin', 'manager']);
      allow create: if hasAnyRole(['admin', 'manager', 'cashier', 'waiter']);
      allow update: if hasAnyRole(['admin', 'manager']); // e.g. to void
    }
    
    // --- Customers & Suppliers ---
     match /customers/{customerId} {
      allow read, write: if hasAnyRole(['admin', 'manager', 'cashier']);
    }
    match /suppliers/{supplierId} {
      allow read, write: if hasAnyRole(['admin', 'manager']);
    }
    
    // --- Settings ---
    match /settings/main {
       allow read: if isSignedIn();
       allow write: if hasAnyRole(['admin', 'manager']);
    }
  }
}
