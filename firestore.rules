rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for roles
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    function isManager() {
      return request.auth != null && request.auth.token.role in ['admin', 'manager'];
    }
    
    function isPosUser() {
       return request.auth != null && request.auth.token.role in ['admin', 'manager', 'cashier', 'waiter'];
    }
    
    function isKitchenUser() {
      return request.auth != null && request.auth.token.role in ['admin', 'manager', 'kitchen'];
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users: Admins can do anything. Managers can edit users but not change roles to admin.
    // All authenticated users can read their own record to get profile info.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
      allow update: if isManager() && !(request.resource.data.role == 'admin' && resource.data.role != 'admin');
    }

    // Products & Categories: Writable by managers, readable by staff.
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if isManager();
    }
    
    match /categories/{categoryId} {
      allow read: if request.auth != null;
      allow write: if isManager();
    }
    
    // Inventory: Only managers can write. Staff can read.
    match /inventory/{inventoryId} {
       allow read: if request.auth != null;
       allow write: if isManager();
    }
    
    // Orders: Readable by staff. Writable by POS users.
    match /orders/{orderId} {
      allow read: if isPosUser() || isKitchenUser();
      allow write: if false; // Server-only writes

       match /items/{itemId} {
        allow read: if isPosUser() || isKitchenUser();
        allow write: if false; // Server-only writes
      }
    }

    // Counters: Server-only writes
    match /counters/{docId} {
        allow read: if isPosUser();
        allow write: if false;
    }
  }
}
