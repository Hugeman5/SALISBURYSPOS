
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper functions
    function isAuthed() {
      return request.auth != null;
    }
    function hasRole(allowedRoles) {
      return request.auth != null && request.auth.token.role in allowedRoles;
    }
    function isStaff() {
      return hasRole(['admin', 'manager', 'cashier', 'waiter', 'kitchen']);
    }

    // Login page needs to read users to show the list
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if hasRole(['admin']);
    }
    match /userSecrets/{userId} {
      allow read, write: if false; // Server-only
    }
    
    // Products and Categories readable by staff
    match /products/{productId} {
      allow read: if isAuthed();
      allow create, update, delete: if hasRole(['admin', 'manager']);
    }
    match /categories/{categoryId} {
      allow read: if isAuthed();
      allow create, update, delete: if hasRole(['admin', 'manager']);
    }
    
    // Inventory ledger is append-only via Functions
    match /inventory_ledger/{docId} {
      allow read: if isAuthed();
      allow create: if hasRole(['admin','manager']);
      allow update, delete: if false;
    }

    // Orders are written by Functions, readable by staff
    match /orders/{orderId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Registers and sessions are server-only writes
    match /registers/{regId} {
      allow read: if isStaff();
      allow write: if false;

      match /sessions/{sessId} {
        allow read: if isStaff();
        allow write: if false;

        match /movements/{movId} {
          allow read: if isStaff();
          allow write: if false;
        }
      }
    }
    
    // Z-Closures are server-written, staff-read
    match /z_closures/{date} {
      allow read: if isStaff();
      allow write: if false;
    }
  }
}
