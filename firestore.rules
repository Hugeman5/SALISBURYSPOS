rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Publicly list/select users for the login grid.
    // (These docs MUST NOT contain secret fields.)
    match /users/{uid} {
      // unauthenticated read allowed so the login page can render
      allow get, list: if true;

      // only admins can write users from the client
      allow create, update, delete: if isAdmin();
    }

    // All secrets live here. Only Admin SDK (server) can access.
    // (Admin SDK bypasses rules; client access is fully blocked.)
    match /userSecrets/{uid} {
      allow read, write: if false;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }
  }
}
