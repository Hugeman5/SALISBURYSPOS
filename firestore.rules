rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function hasRole(r) {
      return request.auth != null && request.auth.token.role == r;
    }
    function isStaff() {
      return request.auth != null && (
        request.auth.token.role in ['admin','manager','cashier','waiter','kitchen']
      );
    }

    // USERS: list on login needs to be readable by anyone (no auth) OR staff only.
    // If you want public login list: replace `isStaff()` with `true`.
    match /users/{uid} {
      allow read: if true; // show name/avatar/role/active on login screen
      allow write: if false; // writes only via callable functions
    }

    // User secrets (PIN hashes) never readable/writable from client
    match /user_secrets/{uid} {
      allow read, write: if false;
    }

    // Products
    match /products/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Inventory ledger
    match /inventory_ledger/{id} {
      allow read: if hasRole('admin') || hasRole('manager');
      allow write: if false;
    }

    // Orders (staff can read)
    match /orders/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Time clock / sessions
    match /time_clock/{uid}/sessions/{sessionId} {
      allow read: if isStaff();
      allow write: if false; // All writes via callables
    }
    
    match /register_sessions/{id} {
      allow read: if hasRole('admin') || hasRole('manager');
      allow write: if false;
    }
    match /register_sessions/{id}/cash_movements/{moveId} {
      allow read: if hasRole('admin') || hasRole('manager');
      allow write: if false;
    }

    // Z-Reports
    match /z_closures/{dateKey} {
      allow read: if hasRole('admin') || hasRole('manager');
      allow write: if false;
    }

    // Settings (locked for now)
    match /settings/{doc} {
      allow read: if isStaff();
      allow write: if false;
    }
     // Categories (locked for now)
    match /categories/{doc} {
      allow read: if isStaff();
      allow write: if false;
    }
     // Registers (locked for now)
    match /registers/{doc} {
      allow read: if isStaff();
      allow write: if false;
    }
  }
}