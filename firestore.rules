
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function hasRole(r) {
      return request.auth != null && request.auth.token.role == r;
    }

    function isStaff() {
      return request.auth != null && (
        request.auth.token.role in ['admin','manager','cashier','waiter','kitchen']
      );
    }

    match /users/{uid} {
      // Publicly readable for login screen user list
      allow read: if true; 
      // All writes must go through secure callable functions
      allow write: if false; 
    }

    match /user_secrets/{uid} {
      // Never readable or writable from the client
      allow read, write: if false;
    }

    match /products/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
    
    match /categories/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /inventory_ledger/{id} {
      allow read: if hasRole('admin') || hasRole('manager');
      allow write: if false;
    }

    match /orders/{orderId} {
      allow read: if isStaff();
      allow write: if false;
      
      match /refunds/{refundId} {
        allow read: if isStaff();
        allow write: if false;
      }
    }

    match /time_clock/{uid}/{**} {
        allow read: if request.auth.uid == uid || hasRole('admin') || hasRole('manager');
        allow write: if false;
    }
    
    match /register_sessions/{id} {
      allow read: if hasRole('admin') || hasRole('manager');
      allow write: if false;

      match /cash_movements/{moveId} {
        allow read: if hasRole('admin') || hasRole('manager');
        allow write: if false;
      }
    }

    match /z_closures/{dateKey} {
      allow read: if hasRole('admin') || hasRole('manager');
      allow write: if false;
    }

    match /registers/{doc} {
      allow read: if isStaff();
      allow write: if false;
    }
  }
}
