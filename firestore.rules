
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    function hasRole(r) {
      return request.auth.token.role == r;
    }
    function isAdmin() {
      return hasRole('admin');
    }
    function isAdminOrManager() {
      return hasRole('admin') || hasRole('manager');
    }
    function isStaff() {
        return hasRole('admin') || hasRole('manager') || hasRole('cashier') || hasRole('waiter') || hasRole('kitchen');
    }
  
    // --- User Data ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrManager();
    }
    match /user_secrets/{userId} {
      allow read, write: if false; // Only accessible by backend functions
    }
    
    // --- Products & Inventory ---
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrManager();
    }
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrManager();
    }
    match /inventory_ledger/{ledgerId} {
      allow read: if isAdminOrManager();
      allow create: if isAdminOrManager(); // Written by backend
      allow update, delete: if false;
    }

    // --- Orders & Sales ---
    match /orders/{orderId} {
      allow read: if isStaff();
      allow create, update: if hasRole('admin') || hasRole('manager') || hasRole('cashier');
      match /refunds/{refundId} {
        allow read: if isStaff();
        allow create: if hasRole('admin') || hasRole('manager') || hasRole('cashier');
        allow update, delete: if false;
      }
    }

    // --- Cash Register ---
    match /register_sessions/{sid} {
      allow read: if isStaff();
      allow create: if hasRole('admin') || hasRole('manager') || hasRole('cashier');
      allow update: if isAdminOrManager() || (hasRole('cashier') && request.resource.data.status == 'closed');
      allow delete: if false; // immutable bookkeeping
    }
     match /register_sessions/{sid}/cash_movements/{mid} {
      allow read: if isStaff();
      allow create: if hasRole('admin') || hasRole('manager') || hasRole('cashier');
      allow update, delete: if false; // immutable
    }

    // --- Reporting ---
    match /z_closures/{zid} {
      allow read: if isAdminOrManager();
      allow create: if isAdminOrManager();
      allow update, delete: if false; // idempotent; create-only
    }
     match /returns_ledger/{rid} {
      allow read: if isStaff();
      allow create: if isAdminOrManager() || hasRole('cashier');
      allow update, delete: if false;
    }

    // --- Staff Management ---
    match /time_clock/{tid} {
      allow read: if isStaff();
      allow create: if isStaff(); // any staff can clock-in/out
      allow update: if isStaff() && (resource.data.uid == request.auth.uid || isAdminOrManager());
      allow delete: if isAdmin();
    }
    
    // --- Menu & Table Management ---
    match /menu_categories/{cid} {
      allow read: if isStaff();
      allow create, update: if isAdminOrManager();
      allow delete: if false;
    }
    match /menu_items/{iid} {
      allow read: if isStaff();
      allow create, update: if isAdminOrManager();
      allow delete: if false;
    }
    match /modifier_groups/{gid} {
      allow read: if isStaff();
      allow create, update: if isAdminOrManager();
      allow delete: if false;
    }
    match /floor_plans/{fid} {
      allow read: if isStaff();
      allow create, update: if isAdminOrManager();
      allow delete: if false;
    }
    match /table_state/{tid} {
      allow read: if isStaff();
      allow create, update: if hasRole('admin') || hasRole('manager') || hasRole('cashier') || hasRole('waiter');
      allow delete: if false;
    }
  }
}
