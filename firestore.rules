rules_version = '2';
updatedAt: string;
}


export interface ZClosure {
id: string; // z_YYYY-MM-DD_location
date: string; // YYYY-MM-DD
locationId: string;
registerSessionIds: string[];
paymentTotals: Record<string, number>;
grossSalesCents: number;
netSalesCents: number;
discountsCents: number;
returnsCents: number;
taxCents: number;
cashExpectedCents: number;
cashCountedCents: number;
cashOverShortCents: number;
generatedByUserId: string;
generatedAt: string;
notes?: string;
}


export interface TimeClockEntry { id: string; userId: string; locationId: string; inAt: string; outAt?: string; hourlyRateCents?: number; minutes?: number; }
export interface RefundRequestLine { lineId: string; qty: number; reason: 'customer_change'|'quality'|'wrong_item'|'void_error'|'other'; note?: string; }


export type ApprovalType = 'cash_movement' | 'discount';
export interface PendingApproval {
id: string; type: ApprovalType; status: 'pending'|'approved'|'denied';
requestedByUserId: string; requestedAt: string;
cash?: { sessionId: string; amountCents: number; direction: 'in'|'out'; reason: string; note?: string };
discount?: { orderId: string; lineId: string; discountType: 'percent'|'amount'|'comp'|'promo'|'bogo'; discountValue: number; reason?: string };
approvedByUserId?: string; approvedAt?: string; decisionNote?: string;
}


export interface CreditNote {
id: string; orderId: string; customerId?: string; amountCents: number; remainingCents: number; status: 'open'|'redeemed'|'void';
issuedAt: string; issuedByUserId: string; redeemedAt?: string; redeemedByOrderId?: string;
}


export interface MenuCategory { id: string; name: string; color?: string; order: number; active: boolean; createdAt: string; updatedAt: string }
export interface ModifierItem { id: string; name: string; priceDeltaCents: number; active: boolean }
export interface ModifierGroup { id: string; name: string; min: number; max: number; items: ModifierItem[]; active: boolean }
export interface MenuItem {
id: string; name: string; sku?: string; plu?: string; categoryId: string; priceCents: number; taxRate?: number; active: boolean;
imageUrl?: string; tags?: string[]; modifierGroupIds?: string[]; availability?: { days?: number[]; from?: string; to?: string }; createdAt: string; updatedAt: string;
}


export type TableShape = 'rect'|'round';
export interface FloorPlanTable { id: string; name: string; shape: TableShape; x: number; y: number; w: number; h: number; seats: number; zone?: string; active: boolean }
export interface FloorPlan { id: string; locationId: string; name: string; width: number; height: number; tables: FloorPlanTable[]; updatedAt: string }
export interface TableState { id: string; locationId: string; status: 'open'|'occupied'|'dirty'|'reserved'|'merged'; serverUserId?: string; covers?: number; orderId?: string; mergedIntoId?: string; updatedAt: string }