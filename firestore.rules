rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper functions to get user auth state
    function authed() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function isOneOf(allowed_roles) { return authed() && role() in allowed_roles; }
    function isAdmin() { return isOneOf(['admin']); }
    function isManager() { return isOneOf(['admin', 'manager']); }
    function isStaff() { return isOneOf(['admin', 'manager', 'cashier', 'waiter', 'kitchen']); }

    // PUBLIC: Login page needs this
    match /users/{uid} {
      allow read: if true;
      allow write: if isManager();
    }
    match /user_secrets/{uid} {
      allow read, write: if false; // Only backend access
    }

    // MENU & FLOOR
    match /menu_categories/{id} {
      allow read: if isStaff();
      allow write: if isManager();
    }
    match /menu_items/{id} {
      allow read: if isStaff();
      allow write: if isManager();
    }
    match /modifier_groups/{id} {
      allow read: if isStaff();
      allow write: if isManager();
    }
    match /floor_plans/{id} {
      allow read: if isStaff();
      allow write: if isManager();
    }
    match /table_state/{id} {
      allow read, write: if isStaff();
    }
    
    // PRODUCTS & INVENTORY (more restricted)
    match /products/{id} {
      allow read, write: if isManager();
    }
    match /inventory_ledger/{id} {
      allow read, write: if isManager();
    }
    
    // ORDERS & SESSIONS
    match /orders/{id} {
      allow read, write: if isStaff();
    }
    match /register_sessions/{id} {
      allow read, write: if isStaff();
    }
    match /cash_movements/{id} {
      allow read, write: if isStaff();
    }
    match /time_clock/{id} {
      allow read, write: if isStaff();
    }
    match /z_closures/{id} {
      allow read, write: if isManager();
    }
  }
}

    