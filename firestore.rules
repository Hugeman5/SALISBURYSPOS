rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public profile docs used by the login grid.
    // DO NOT store pinHash or other secrets here.
    match /users/{uid} {
      allow get, list: if true;            // allow unauth read for login grid
      allow create, update, delete: if isAdmin();
      // Deny direct writes to pinHash from clients
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'role', 'active', 'avatarUrl', 'updatedAt']);
    }

    // Secrets only. Client must never reach this.
    match /userSecrets/{uid} {
      allow read, write: if false;         // block client entirely
    }

    // PRODUCTS
    match /products/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && (request.auth.token.role in ['admin', 'manager']);
      allow delete: if request.auth != null
        && (request.auth.token.role == 'admin'); // delete restricted to admin
    }

    // CATEGORIES
    match /categories/{id} {
      allow read: if true;
      allow write: if request.auth != null
        && (request.auth.token.role in ['admin', 'manager']);
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }
  }
}
