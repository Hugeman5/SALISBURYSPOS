
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper functions
    function isAuthed() {
      return request.auth != null;
    }
    
    function hasRole(allowedRoles) {
      return request.auth != null && request.auth.token.role in allowedRoles;
    }

    // PUBLIC: Users collection readable for PIN login screen
    match /users/{userId} {
      allow read: if true;
      allow write: if hasRole(['admin', 'manager']);
    }
    
    // PROTECTED: User secrets are not readable by clients
    match /userSecrets/{userId} {
      allow read, write: if false;
    }
    
    // PROTECTED: Products can be read by any authenticated user, but only written by admin/manager
    match /products/{productId} {
      allow read: if isAuthed();
      allow create, update, delete: if hasRole(['admin', 'manager']);
    }

    // PROTECTED: Categories can be read by any authenticated user, but only written by admin/manager
    match /categories/{categoryId} {
      allow read: if isAuthed();
      allow write: if hasRole(['admin', 'manager']);
    }

    // PROTECTED: Inventory ledger is append-only via functions, readable by staff
    match /inventory_ledger/{docId} {
      allow read: if isAuthed();
      allow create: if hasRole(['admin', 'manager']);
      allow update, delete: if false;
    }
    
    // PROTECTED: Orders are written via functions, readable by staff
    match /orders/{orderId} {
      allow read: if isAuthed();
      allow write: if false;
    }

    // PROTECTED: Registers and their subcollections are server-write only
    match /registers/{registerId} {
        allow read: if hasRole(['admin', 'manager', 'cashier']);
        allow write: if false;

        match /sessions/{sessionId} {
            allow read: if hasRole(['admin', 'manager', 'cashier']);
            allow write: if false;

            match /movements/{movementId} {
                allow read: if hasRole(['admin', 'manager', 'cashier']);
                allow write: if false;
            }
        }
    }

    // PROTECTED: Z-Closures are server-written, staff-read
    match /z_closures/{day} {
        allow read: if hasRole(['admin', 'manager', 'cashier']);
        allow write: if false;
    }

    // PROTECTED: Time Clock entries
    match /time_clock/{punchId} {
      allow read: if hasRole(['admin', 'manager']) || (request.auth != null && request.auth.uid == resource.data.uid);
      allow write: if false; // writes via Cloud Functions only
    }
  }
}
