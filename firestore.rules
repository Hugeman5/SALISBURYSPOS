
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthed() {
      return request.auth != null;
    }

    function hasRole(allowedRoles) {
      return isAuthed() && request.auth.token.role in allowedRoles;
    }

    // Public profile docs used by the login grid.
    // DO NOT store pinHash or other secrets here.
    match /users/{uid} {
      allow get, list: if true; // allow unauth read for login grid
      allow create, update, delete: if hasRole(['admin']);
      // Deny direct writes to pinHash from clients
      allow update: if !('pinHash' in request.resource.data.diff(resource.data).affectedKeys());
    }

    // Secrets only. Client must never reach this.
    match /userSecrets/{uid} {
      allow read, write: if false; // block client entirely
    }

    // PRODUCTS
    match /products/{id} {
      allow read: if true;
      allow create, update: if hasRole(['admin', 'manager']);
      allow delete: if hasRole(['admin']);
    }

    // CATEGORIES
    match /categories/{id} {
      allow read: if true;
      allow write: if hasRole(['admin', 'manager']);
    }
    
    // INVENTORY LEDGER
    match /inventory_ledger/{docId} {
      allow read: if isAuthed();
      // Writes only via privileged roles through Cloud Functions
      allow create: if hasRole(['admin', 'manager']);
      allow update, delete: if false; // Append-only
    }
  }
}
