rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function authed() {
      return request.auth != null;
    }
    function role() {
      return request.auth.token.role;
    }

    // --- USER DATA & SECRETS ---
    // Public user data for login screen
    match /users/{uid} {
      allow read: if true;
      allow write: if authed() && (role() in ['admin','manager']);
    }

    // PIN hashes and other secrets are private
    match /user_secrets/{uid} {
      allow read, write: if false; // Only accessible via backend functions
    }
    
    // --- MENU & FLOOR CONFIGURATION (Admin/Manager only) ---
    match /{path=**}/menus/{id} {
      allow read: if authed();
      allow write: if authed() && role() in ['admin', 'manager'];
    }
     match /{path=**}/menu_screens/{id} {
      allow read: if authed();
      allow write: if authed() && role() in ['admin', 'manager'];
    }
     match /{path=**}/menu_buttons/{id} {
      allow read: if authed();
      allow write: if authed() && role() in ['admin', 'manager'];
    }
     match /{path=**}/items/{id} {
      allow read: if authed();
      allow write: if authed() && role() in ['admin', 'manager'];
    }
     match /{path=**}/modifier_groups/{id} {
      allow read: if authed();
      allow write: if authed() && role() in ['admin', 'manager'];
    }
    match /{path=**}/combos/{id} {
      allow read: if authed();
      allow write: if authed() && role() in ['admin', 'manager'];
    }
     match /{path=**}/price_rules/{id} {
      allow read: if authed();
      allow write: if authed() && role() in ['admin', 'manager'];
    }
     match /{path=**}/menu_availability/{id} {
      allow read: if authed();
      allow write: if authed() && role() in ['admin', 'manager'];
    }
    
    match /floor_plans/{id} {
       allow read: if authed();
       allow write: if authed() && role() in ['admin', 'manager'];
    }

    // --- OPERATIONAL DATA ---
    match /table_state/{id} {
       allow read: if authed();
       allow write: if authed() && role() in ['admin', 'manager', 'cashier', 'waiter'];
    }

    // Fallback: Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
