rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function hasRole(r) { return isSignedIn() && request.auth.token.role == r; }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }

    // Users
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if hasRole('admin') || (isSelf(uid) && request.resource.data.diff(resource.data).changedKeys().hasOnly(['active']) == false);
    }

    // Shifts (time clock)
    match /shifts/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn(); // anyone clock themselves
      allow update: if isSignedIn();
      allow delete: if hasRole('admin');
    }

    // Menu, Ingredients, Tables, Orders, Payments, KDS, Settings
    match /{document=**} {
      allow read: if isSignedIn();
      allow write: if hasRole('admin');
    }
  }
}
