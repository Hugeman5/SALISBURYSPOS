rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthed() {
      return request.auth != null;
    }
    function hasRole(roles) {
      return request.auth != null && request.auth.token.role in roles;
    }
    function isStaff() {
      return request.auth != null &&
      request.auth.token.role in ['cashier', 'manager', 'admin'];
    }

    // Public read for login screen
    match /users/{userId} {
      allow get: if true;
      allow list: if true;
      allow write: if hasRole(['admin', 'manager']);
    }

    // Server-side only
    match /userSecrets/{userId} {
      allow read, write: if false;
    }

    // Products & Categories
    match /products/{productId} {
      allow read: if isAuthed();
      allow write: if hasRole(['admin', 'manager']);
    }
    match /categories/{categoryId} {
      allow read: if isAuthed();
      allow write: if hasRole(['admin', 'manager']);
    }

    // Inventory ledger is append-only by server
    match /inventory_ledger/{docId} {
      allow read: if isAuthed();
      allow create: if hasRole(['admin', 'manager']);
      allow update, delete: if false; 
    }

    // Settings (readable by staff, write via server only)
    match /settings/general {
      allow read: if isStaff();
      allow write: if false;
    }

    // Orders (and subcollections) readable by staff, write by server only
    match /orders/{orderId} {
      allow read: if isStaff();
      allow write: if false;

      match /lines/{lineId} {
        allow read: if isStaff();
        allow write: if false;
      }
      match /payments/{paymentId} {
        allow read: if isStaff();
        allow write: if false;
      }
    }
  }
}