rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public profile docs used by the login grid.
    // DO NOT store pinHash or other secrets here.
    match /users/{uid} {
      allow get, list: if true;            // allow unauth read for login grid
      allow create, update: if isAdmin() || isManager();
      allow delete: if isAdmin();
    }

    // Secrets only. Client must never reach this.
    match /userSecrets/{uid} {
      allow read, write: if false;         // block client entirely
    }

    // PRODUCTS
    match /products/{id} {
      allow read: if true;
      allow create, update: if isAdmin() || isManager();
      allow delete: if isAdmin();
    }

    // CATEGORIES
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin() || isManager();
    }

    // Inventory ledger
    match /inventory_ledger/{docId} {
      allow read: if isAuthed();
      allow create: if isAdmin() || isManager();
      allow update, delete: if false; // append-only
    }
    
    // ORDERS
    match /orders/{id} {
      allow read: if isStaff();
      allow write: if false; // all writes via server-side logic
    }
    
    match /orders/{orderId}/items/{itemId} {
      allow read: if isStaff();
      allow write: if false;
    }

    function isAuthed() {
      return request.auth != null;
    }
    
    function isStaff() {
      return isAuthed() && request.auth.token.role in ['cashier','manager','admin'];
    }

    function isAdmin() {
      return isAuthed() && request.auth.token.role == 'admin';
    }
    
    function isManager() {
        return isAuthed() && request.auth.token.role == 'manager';
    }
  }
}
