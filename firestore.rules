rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasAnyRole(roles) {
      // role claim comes from the custom token you create in pin-login
      return isSignedIn() && request.auth.token.role in roles;
    }

    function isAdmin()   { return isSignedIn() && request.auth.token.role == 'admin'; }
    function isManager() { return isSignedIn() && request.auth.token.role == 'manager'; }

    // ---- USERS ----
    match /users/{userId} {
      // Allow anyone to read the user list for the login screen.
      // Writes are still restricted to admins.
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- PRODUCTS ----
    match /products/{id} {
      // Admin & Manager read/write, others read-only
      allow read:  if isSignedIn();
      allow write: if hasAnyRole(['admin','manager']);
    }

    // ---- INVENTORY ----
    match /inventory/{id} {
      allow read:  if hasAnyRole(['admin','manager']);
      allow write: if hasAnyRole(['admin','manager']);
    }

    // ---- ORDERS (example) ----
    match /orders/{orderId} {
      allow read:  if hasAnyRole(['admin','manager']);
      allow write: if hasAnyRole(['admin','manager']); // tighten later per workflow
      match /items/{itemId} {
        allow read, write: if hasAnyRole(['admin','manager']);
      }
    }
  }
}
