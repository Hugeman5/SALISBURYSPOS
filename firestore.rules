rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function signedIn() { 
      return request.auth != null; 
    }
    function hasRole(roles) {
      return signedIn() && request.auth.token.role in roles;
    }
    function isAdmin()   { return hasRole(['admin']); }
    function isManager() { return hasRole(['admin', 'manager']); }
    function isStaff()   { return hasRole(['admin', 'manager', 'cashier', 'waiter', 'kitchen']); }

    // Public read so unauth login screen can list users
    match /users/{uid} {
      allow read: if true;
      allow write: if isManager(); // admin or manager
    }

    // Never readable from client; only admin/manager can set/reset via callable
    match /user_secrets/{uid} {
      allow read: if false;
      allow write: if false; // Writes must go through callables
    }

    match /products/{productId} {
      allow read: if isStaff();
      allow write: if isManager();
    }
    
    match /categories/{categoryId} {
       allow read: if isStaff();
       allow write: if isManager();
    }
    
    match /orders/{orderId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /inventory_ledger/{entryId} {
        allow read: if isManager();
        allow write: if isManager();
    }

    match /time_clock/{uid}/sessions/{sessionId} {
      allow read: if isStaff();
      allow write: if request.auth.uid == uid || isManager();
    }
  }
}
