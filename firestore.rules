rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Start of Functions ---
    function isAuth() {
      return request.auth != null;
    }
    function isUser(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isAuth() && request.auth.token.role == 'admin';
    }
    function isManager() {
      return isAuth() && request.auth.token.role in ['admin', 'manager'];
    }
    function isCashier() {
      return isAuth() && request.auth.token.role in ['admin', 'manager', 'cashier'];
    }
    // --- End of Functions ---


    // --- Start of Collections ---
    match /users/{userId} {
      // Allow reading user list for login screen, but only non-sensitive fields.
      // A specific user can read their own full document.
      allow list: if true;
      allow get: if isUser(userId) || isManager();

      // PIN can only be changed by server, other fields by managers/admins.
      allow create: if isManager();
      allow update: if isManager() && !("pinHash" in request.resource.data);
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isAuth();
      allow write: if isManager();
    }

    match /categories/{categoryId} {
      allow read: if isAuth();
      allow write: if isManager();
    }
    
    match /orders/{orderId} {
      allow read: if isCashier();
      allow create: if isCashier();
      allow update, delete: if isManager(); // For voiding, etc.
      
      match /items/{itemId} {
        allow read: if isCashier();
        allow create: if isCashier();
        allow update, delete: if isManager();
      }
    }

    match /counters/{counterId} {
      // Server-side only
      allow read, write: if false;
    }

    match /idempotency_keys/{keyId} {
      // Server-side only
      allow read, write: if false;
    }
  }
}
